# podman-watchdog secret env — COPY to /etc/podman-watchdog/watchdog.env (chmod 600) on the host.
# This file (.example) is the ONLY env file tracked in git. The real watchdog.env
# is git-ignored and must never be committed/pushed to GitHub.
#
# The Discord webhook URL is injected here at deploy time (systemd EnvironmentFile).
# It takes precedence over discord.webhookUrl in config.json, so config.json can
# keep webhookUrl empty.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME
