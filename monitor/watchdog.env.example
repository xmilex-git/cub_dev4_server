# podman-watchdog secret env — COPY to /etc/podman-watchdog/watchdog.env (chmod 600) on the host.
# This file (.example) is the ONLY env file tracked in git. The real watchdog.env
# is git-ignored and must never be committed/pushed to GitHub.
#
# Webhook URLs are injected here at deploy time (systemd EnvironmentFile). Each
# takes precedence over the matching webhookUrl in config.json, so config.json
# can keep both empty. Set only the one(s) your `notifier` uses.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME
# Microsoft Teams Power Automate "Workflows" incoming webhook (the sig= query
# param IS the auth — treat the whole URL as a secret; never commit it).
TEAMS_WEBHOOK_URL=https://REPLACE_ME.environment.api.powerplatform.com/powerautomate/automations/direct/workflows/REPLACE_ME/triggers/manual/paths/invoke?REPLACE_ME
