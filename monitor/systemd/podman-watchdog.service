[Unit]
Description=Podman host risk-monitoring watchdog (read-only, no-kill)
Documentation=file:/opt/podman-watchdog/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Secret injection: the Discord webhook URL is provided via DISCORD_WEBHOOK_URL
# in this git-ignored 0600 env file (never in the repo). The leading "-" makes it
# optional so the unit still starts if the file is absent.
EnvironmentFile=-/etc/podman-watchdog/watchdog.env
ExecStart=/usr/bin/node /opt/podman-watchdog/src/index.js --config /etc/podman-watchdog/config.json
Restart=on-failure
RestartSec=5

# Dead-man switch: if the watchdog hangs and stops sending WATCHDOG=1 within
# this window, systemd restarts it (the monitor's worst failure is going silent).
WatchdogSec=30

# Self-resource caps so the monitor can never become the resource consumer it
# watches. V8 heap is bounded inside MemoryMax.
MemoryMax=256M
TasksMax=128

User=root
NoNewPrivileges=true

# Hardening — tuned to this host's reality (discovered during P2/deploy):
#  * ProtectSystem=full (NOT strict): the enrich tick runs rootful `podman ps`
#    for the id->name map; podman needs /run writable. strict made /run
#    read-only -> podman ps failed -> the widget showed bare IDs. `full` keeps
#    /usr,/boot,/etc read-only; /var + /run stay writable.
#  * ProtectHome is intentionally NOT set: podman's graphroot is /home/podman
#    (this host puts container storage on the 3 TB /home disk). ProtectHome=true
#    hides /home -> "mkdir /home/podman: read-only file system" -> podman ps
#    fails. Under ProtectSystem=full, /home stays read-write.
#  * PrivateTmp=false: keep the host /tmp for podman.
#  (RestrictSUIDSGID omitted: unknown directive on this host's systemd 239.)
ProtectSystem=full
ReadWritePaths=/var/lib/podman-watchdog /var/log/podman-watchdog
PrivateTmp=false
ProtectKernelTunables=true
# Safe to keep: we only READ cgroup pids files; read-only /sys/fs/cgroup also
# reinforces the no-kill invariant (cannot write cgroup control files).
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
